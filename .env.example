# Copy this file to .env and replace placeholders with real values.
# This file is intentionally not secret.

# Required for external integrations the dashboard may use.
OPENWEATHER_API_KEY=your_openweather_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Backend CORS configuration for hosted frontend origins.
ALLOWED_ORIGINS=https://lillyboy-aero-logistics.hf.space,https://huggingface.co

# Optional backend configuration.
AIRPOWER_USERS={"demo-analyst": ["analyst", "analyst"], "demo-officer": ["maint_officer", "maint_officer"], "demo-commander": ["commander", "commander"]}
